{"tool_version":"0.1.0","contract_version":"1","quick_ref":{"summary":"Validate a suite, replay recorded outputs, then compare reports. Live targets need --revision.","top_3":[{"id":"validate","command":"intentgauge validate examples/rag/suite.json","reason":"Reject a bad suite before spending a run."},{"id":"replay","command":"intentgauge run examples/rag/suite.json --replay examples/rag/outputs.json","reason":"Score recorded outputs with no network and no credentials."},{"id":"compare","command":"intentgauge compare BASELINE/report.json CANDIDATE/report.json","reason":"Exit 1 when the candidate regresses against the baseline."}]},"recommendations":[{"id":"replay-demo","title":"Run the offline RAG demo","reason":"Confirms the tool, the suite, and a passing gate without a service.","command":"intentgauge run examples/rag/suite.json --replay examples/rag/outputs.json"},{"id":"compare-regression","title":"Compare a known regression","reason":"Exit 1 is the regression signal. Read stdout JSON.","command":"intentgauge compare BASELINE/report.json CANDIDATE/report.json"}],"commands":["intentgauge validate examples/rag/suite.json","intentgauge run examples/rag/suite.json --replay examples/rag/outputs.json","intentgauge compare BASELINE/report.json CANDIDATE/report.json","intentgauge capabilities --json","intentgauge robot-docs guide","intentgauge dashboard RUNS_DIRECTORY --once"],"health":{"offline_ok":true,"network_required":false,"destructive_commands":false,"stdout":"data","stderr":"diagnostics"},"warnings":[],"data_hash":"8387b42f8abfe54d"}
