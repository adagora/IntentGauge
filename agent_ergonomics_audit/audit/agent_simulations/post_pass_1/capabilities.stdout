{"tool_name":"intentgauge","version":"0.1.0","api_version":1,"contract_version":"1","features":["json_output","robot_triage","robot_docs","levenshtein_typo_hint","deterministic_robot_output","stdout_data_stderr_diagnostics"],"commands":{"validate":{"description":"Parse a suite and report its name and case count.","mutates":false,"json":true,"robot":"--json","args":[{"name":"SUITE.json","required":true,"type":"path"}],"exit_codes":[0,2]},"run":{"description":"Evaluate a suite and write a new report directory.","mutates":true,"json":true,"robot":"--json","side_effects":"Writes report.json and report.html. Refuses to replace an existing report. --http and --chatbot call a live service.","safe_alternative":"intentgauge run SUITE.json --replay OUTPUTS.json --out runs/NEW_DIRECTORY","exit_codes":[0,1,2]},"compare":{"description":"Compare a baseline report with a candidate report.","mutates":false,"json":true,"robot":"--json","exit_codes":[0,1,2]},"calibrate":{"description":"Score judge eligibility against held-out labels.","mutates":false,"json":true,"robot":"--json","exit_codes":[0,1,2]},"dashboard":{"description":"Serve saved runs until stopped. --once prints the saved-run summary as JSON and exits.","mutates":false,"json":true,"long_running":true,"safe_alternative":"intentgauge dashboard RUNS_DIRECTORY --once","exit_codes":[0,2]},"capabilities":{"description":"Print this contract as JSON.","mutates":false,"json":true,"robot":"--json","exit_codes":[0,2]},"robot-docs":{"description":"Print the agent handbook.","mutates":false,"json":true,"robot":"--json","args":[{"name":"guide","required":true,"type":"topic"}],"exit_codes":[0,2]},"help":{"description":"Print human help for one command or the whole tool.","mutates":false,"json":false,"exit_codes":[0,2]},"version":{"description":"Print the package name and version as JSON.","mutates":false,"json":true,"exit_codes":[0,2]}},"exit_codes":{"0":{"meaning":"gates passed or the command succeeded","retryable":false},"1":{"meaning":"evaluation, regression, or calibration failed; stdout holds the result","retryable":false},"2":{"meaning":"configuration or usage error; stderr holds error and, for usage mistakes, hint","retryable":false}},"exit_code_note":"Exit 1 is a failed gate, not a usage error. These three codes are the product contract. Do not remap them.","flags":{"global":{"--json":"Accept JSON on read commands. With no command, print machine help.","--robot-triage":"One JSON object: quick_ref, recommendations, commands, health.","--robot-help":"Alias of robot-docs guide.","--version":"Alias of version.","--help":"Human help. Also -h.","--no-color":"Accepted. Help and robot text are already plain.","--color":"Accepted. The CLI does not emit color."}},"env_vars":{"NO_COLOR":{"description":"Accepted. The CLI emits no color, so the output does not change.","default":"unset"},"CI":{"description":"Accepted. The CLI emits no color or progress bar.","default":"unset"},"SOURCE_DATE_EPOCH":{"description":"Robot surfaces omit wall-clock timestamps. A saved run report still records its own clock.","default":"unset"}},"limits":{"max_concurrency":256,"max_repetitions":1000,"max_timeout_ms":2147483647,"default_timeout_ms":30000,"default_concurrency":4,"default_repetitions":1,"default_dashboard_port":4317},"robot_docs_uri":"intentgauge robot-docs guide","mega_command":"intentgauge --robot-triage"}
